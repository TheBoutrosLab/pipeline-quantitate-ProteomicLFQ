includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    mzML_csv = "${projectDir}/test/test_internal_only/mzML.csv"
    idXML_csv = "${projectDir}/test/test_internal_only/idXML.csv"
    ucla_cds = false
    save_intermediate_files = true
    project_name = 'ECOLI_LFQ'
    algorithm = 'FFId'
    fractionated = true
    ffid_strategy = 'internal_only'
}

// Exercise fraction validation with a trailing blank CSV line.
params.mzML_csv = csvEnvironmentExpander.prepareInputCsv(params.mzML_csv, "test_internal_only-mzML_csv", launchDir, true)
params.idXML_csv = csvEnvironmentExpander.prepareInputCsv(params.idXML_csv, "test_internal_only-idXML_csv", launchDir)
methods.setup()

process {
    echo = false
}
