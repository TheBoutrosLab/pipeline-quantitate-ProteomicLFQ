includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    featureXML_entrypoint = true
    featureXML_csv = "${projectDir}/test/test_de_novo_featureXML/featureXML.csv"
    idXML_csv = "${projectDir}/test/test_de_novo/idXML.csv"
    ucla_cds = false
    save_intermediate_files = true
    project_name = 'ECOLI_LFQ'
    algorithm = 'de novo'
    fractionated = true
    filter_mapped_features = true
}

params.featureXML_csv = csvEnvironmentExpander.prepareInputCsv(params.featureXML_csv, "test_de_novo_featureXML-featureXML_csv", launchDir)
params.idXML_csv = csvEnvironmentExpander.prepareInputCsv(params.idXML_csv, "test_de_novo_featureXML-idXML_csv", launchDir)
methods.setup()

process {
    echo = false
}
