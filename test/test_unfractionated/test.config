includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    mzML_csv = "${projectDir}/test/test_unfractionated/mzML.csv"
    idXML_csv = "${projectDir}/test/test_internal_only/idXML.csv"
    ucla_cds = false
    save_intermediate_files = true
    project_name = 'ECOLI_LFQ_UNFRACTIONATED'
    algorithm = 'FFId'
    fractionated = false
    merge_featureXML = false
}

params.mzML_csv = csvEnvironmentExpander.prepareInputCsv(params.mzML_csv, "test_unfractionated-mzML_csv", launchDir)
params.idXML_csv = csvEnvironmentExpander.prepareInputCsv(params.idXML_csv, "test_unfractionated-idXML_csv", launchDir)
methods.setup()

process {
    echo = false
}
