includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    mzML_csv = "${projectDir}/test/test_machine_learning/mzML.csv"
    idXML_csv = "${projectDir}/test/test_machine_learning/idXML.csv"
    ucla_cds = false
    save_intermediate_files = true
    project_name = 'ECOLI_LFQ'
    algorithm = 'FFId'
    ffid_strategy = 'machine_learning'
    find_features_EMGScoring_max_iteration = 1
    find_features_svm_kernel = 'linear'
    find_features_svm_xval = 1
    find_features_svm_log2_C = '1.0'
    find_features_svm_log2_gamma = '1.0'
}

params.mzML_csv = csvEnvironmentExpander.prepareInputCsv(params.mzML_csv, "test_machine_learning-mzML_csv", launchDir)
params.idXML_csv = csvEnvironmentExpander.prepareInputCsv(params.idXML_csv, "test_machine_learning-idXML_csv", launchDir)
methods.setup()
