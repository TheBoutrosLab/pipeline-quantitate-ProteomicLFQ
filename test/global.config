docker {
    enabled = true

    // Pass user's UID/GID and group IDs to Docker
    uid_and_gid = "-u \$(id -u):\$(id -g)"
    all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"

    runOptions = "${uid_and_gid} ${all_group_ids}"
}

process {
    // Copy external fixtures into scratch so Docker can read staged inputs.
    stageInMode = 'copy'
    withName: "find_features_FFId" {
        cpus = 8
    }
    withName: "find_features_FFIdSeeded" {
        cpus = 8
    }
    withName: "seed_features_FFMultiplex" {
        cpus = 8
    }
    withName: "find_features_centroided" {
        cpus = 8
    }
    withName: "align_featureXML_id" {
        cpus = 1
    }
    withName: "transform_rt" {
        cpus = 1
    }
    withName: "link_features" {
        cpus = 1
    }
    withName: "resolve_conflict" {
        cpus = 1
    }
    withName: "quantify_peptides" {
        cpus = 1
    }
}
