includeConfig "../external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "../external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "../external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"
includeConfig "../external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"

PARAMS_SCHEME = [
    'output_dir': null,
    'project_name': null,
    'algorithm': ['de novo', 'FFId']
]

methods {
    set_output_dir = {
        tz = TimeZone.getTimeZone("UTC")
        timestamp = new Date().format("yyyyMMdd'T'HHmmss'Z'", tz)
        software = "OpenMS-${params.openms_version}"

        root_output_dir = "${params.output_dir}/${manifest.name}-${manifest.version}"
        output_dir = "${root_output_dir}/${software}"
        params.final_output_dir = "${output_dir}/output"
        params.intermediate_file_dir = "${output_dir}/intermediate"

        log_dir = "${root_output_dir}/log-${manifest.name}-${manifest.version}-${timestamp}/${software}"
        params.log_output_dir = log_dir
        params.process_log_dir = "${log_dir}/process-log"
        params.pipeline_log_dir = "${log_dir}/nextflow-log"

        trace.enabled = true
        trace.file = "${params.pipeline_log_dir}/trace.txt"

        timeline.enabled = true
        timeline.file = "${params.pipeline_log_dir}/timeline.html"

        report.enabled = true
        report.file = "${params.pipeline_log_dir}/report.html"
    }

    validate_fraction_ids = {
        // Validate that all samples have the same number of fractions.
        def headers2index = [:]
        def sample_id2fraction_ids = [:]
        new File(params.mzML_csv.toString()).withReader { handle ->
            def headers = handle.readLine()?.split(',', -1) as List
            if (!headers || !headers.containsAll(['sample_name', 'fraction_id', 'mzML'])) {
                throw new Exception("Missing sample_name, fraction_id, or mzML header in ${params.mzML_csv}")
            }
            headers.eachWithIndex { header, index ->
                headers2index[header] = index
            }
            handle.eachLine { line, lineNumber ->
                if (line.trim().isEmpty()) {
                    return
                }
                def fields = line.split(',', -1) as List
                def sample_id = fields[headers2index['sample_name']]?.trim()
                def fraction_id = fields[headers2index['fraction_id']]?.trim()
                if (fields.size() != headers.size() || fields.any { field -> field.trim().isEmpty() }) {
                    throw new Exception("Malformed mzML CSV row at line ${lineNumber + 2}: ${fields}")
                }
                if (!sample_id2fraction_ids.containsKey(sample_id)) {
                    sample_id2fraction_ids[sample_id] = [fraction_id]
                } else {
                    sample_id2fraction_ids[sample_id].add(fraction_id)
                }
            }
        }
        def unique_fraction_ids = [] as Set
        sample_id2fraction_ids.each { k, v ->
            unique_fraction_ids.add(v)
        }
        if (unique_fraction_ids.size() > 1) {
            throw new Exception('Not all samples have the same fraction IDs. We expect all samples come from the same experiment. Please verify your `mzML_csv` file.')
        }
    }

    validate = {
        // Validate schema
        PARAMS_SCHEME.each { key, val ->
            if (!(params.containsKey(key))) {
                throw new Exception("Required option ${key} not set.")
            }
            if (val != null && val in Collection) {
                if (!(params[key] in val)) {
                    throw new Exception("${key}: ${params[key]} not supported. The supported options are: ${val}")
                }
            }
        }

        // Validate that input CSVs are set.
        if (params.algorithm == 'FFId' || !(params.featureXML_entrypoint)) {
            keys = ['idXML_csv', 'mzML_csv']
        }
        else {
            keys = ['idXML_csv', 'featureXML_csv']
        }
        for (key in keys) {
            if (!(params.containsKey(key))) {
                throw new Exception("Required option ${key} not set")
            }
        }

        if (!(params.protein_quantifier_fractions_aggregate in ['sum', 'best'])) {
            throw new Exception('protein_quantifier_fractions_aggregate must be sum or best')
        }
        if (params.containsKey('protein_quantifier_ratios')) {
            throw new Exception('protein_quantifier_ratios was removed in OpenMS 3.6; calculate contrasts downstream')
        }
        if (params.containsKey('protein_quantifier_best_charge_and_fraction')) {
            throw new Exception('protein_quantifier_best_charge_and_fraction was renamed to protein_quantifier_best_charge in OpenMS 3.6')
        }
        if (params.algorithm == 'FFId') {
            if (params.ffid_strategy == 'internal_only' &&
                params.keySet().any { it.toString().startsWith('find_features_ident_svm_') }) {
                throw new Exception('OpenMS 3.6 internal-only FFId does not support SVM options')
            }
            methods.validate_fraction_ids()
        }
    }

    set_number_of_samples = {
        if (params.algorithm == 'FFId') {
            input_csv = params.mzML_csv
        } else {
            if (params.featureXML_entrypoint) {
                input_csv = params.featureXML_csv
            } else {
                input_csv = params.mzML_csv
            }
        }
        def unique_sample_names = [] as Set
        new File(input_csv.toString()).withReader { reader ->
            def headers = reader.readLine()?.split(',', -1) as List
            def sample_name_index = headers?.indexOf('sample_name')
            if (sample_name_index == null || sample_name_index < 0) {
                throw new Exception("Missing sample_name header in ${input_csv}")
            }
            reader.eachLine { line ->
                if (!line.trim().isEmpty()) {
                    def fields = line.split(',', -1) as List
                    def sample_name = fields[sample_name_index]?.trim()
                    if (!sample_name) {
                        throw new Exception("Missing sample_name in ${input_csv}: ${fields}")
                    }
                    unique_sample_names.add(sample_name)
                }
            }
        }
        params.unique_sample_names = unique_sample_names
        params.number_of_samples = unique_sample_names.size()
    }

    set_openms_processing_image = {
        // OpenMS 3.6 removed the external-ID and SVM options used by these FFId strategies.
        def legacy_ffid = params.algorithm == 'FFId' && params.ffid_strategy in ['merged', 'machine_learning']
        params.docker_image_openms_processing = legacy_ffid ? params.docker_image_openms_legacy : params.docker_image_openms
        params.docker_image_pyopenms_processing = legacy_ffid ? params.docker_image_pyopenms_legacy : params.docker_image_pyopenms
        if (!legacy_ffid) {
            // Preserve the pre-3.6 median RT reference instead of the new best-run default.
            if (!params.containsKey('align_featureXML_id_algorithm_auto_reference')) {
                params.align_featureXML_id_algorithm_auto_reference = 'consensus'
            }
            if (!params.containsKey('align_idXML_algorithm_auto_reference')) {
                params.align_idXML_algorithm_auto_reference = 'consensus'
            }
        }
    }

    set_global = {
        methods.set_number_of_samples()
    }

    setup = {
        methods.set_output_dir()
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        methods.validate()
        methods.set_openms_processing_image()
        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_env()
        methods.configure_containerization()
        methods.setup_process_afterscript()
        json_extractor.store_object_as_json(params, new File("${params.pipeline_log_dir}/params.json"))
        methods.set_global()
    }
}
